# 라이브 시험 설정.
#
# 이 파일을 .env로 복사하고 값을 채운다. .env는 gitignore에 있으므로 커밋되지 않는다.
# 값이 없는 벤더의 시험은 건너뛴다. 하나만 채워도 그 벤더는 돌아간다.
#
#   cp .env.example .env
#   uv run pytest -m live -s
#
# 느린 시험을 빼려면:
#   uv run pytest -m "live and not slow" -s

# ---- OpenAI 호환 (사내 vLLM, LUXIA) ----
# 로컬 컨테이너 예시: http://127.0.0.1:8000 / qwen3-8b
# 사내 서버 예시:     http://172.16.100.200:14100 / luxia3-llm-32b-0901-Q
ECC_LIVE_BASE_URL=
ECC_LIVE_MODEL=
ECC_LIVE_API_KEY=

# ---- Anthropic Messages ----
ECC_ANTHROPIC_BASE_URL=https://api.anthropic.com
ECC_ANTHROPIC_MODEL=claude-sonnet-5
ECC_ANTHROPIC_API_KEY=

# ---- OpenAI Responses ----
ECC_RESPONSES_BASE_URL=https://api.openai.com
ECC_RESPONSES_MODEL=gpt-4.1
ECC_RESPONSES_API_KEY=

# ---- Gemini GenerateContent ----
ECC_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
ECC_GEMINI_MODEL=gemini-2.5-flash
ECC_GEMINI_API_KEY=
