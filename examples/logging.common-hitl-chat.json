{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "bridge_json": {
      "()": "completion_bridge.logging.JsonFormatter"
    }
  },
  "handlers": {
    "bridge_calls": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "DEBUG",
      "formatter": "bridge_json",
      "filename": "logs/bridge-calls.jsonl",
      "encoding": "utf-8",
      "maxBytes": 20971520,
      "backupCount": 5
    },
    "bridge_sse": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "DEBUG",
      "formatter": "bridge_json",
      "filename": "logs/bridge-sse.jsonl",
      "encoding": "utf-8",
      "maxBytes": 52428800,
      "backupCount": 5
    },
    "bridge_operations": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "INFO",
      "formatter": "bridge_json",
      "filename": "logs/bridge-operations.jsonl",
      "encoding": "utf-8",
      "maxBytes": 10485760,
      "backupCount": 5
    }
  },
  "loggers": {
    "completion_bridge.wire": {
      "level": "DEBUG",
      "handlers": [],
      "propagate": false
    },
    "completion_bridge.wire.calls": {
      "level": "DEBUG",
      "handlers": [
        "bridge_calls"
      ],
      "propagate": false
    },
    "completion_bridge.wire.sse": {
      "level": "DEBUG",
      "handlers": [
        "bridge_sse"
      ],
      "propagate": false
    },
    "completion_bridge.operations": {
      "level": "INFO",
      "handlers": [
        "bridge_operations"
      ],
      "propagate": false
    }
  }
}
